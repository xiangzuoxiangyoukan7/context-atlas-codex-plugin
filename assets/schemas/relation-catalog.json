  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-atlas.dev/schemas/relation-catalog.json",
  "title": "关系类型目录",
  "description": "登记允许的正向关系、源目标身份范围和变化影响等级。",
  "x-context-atlas": {
    "profile": "self_describing/v1",
    "schema_version": "1.0.0",
    "knowledge_type": "relation_catalog",
    "purpose": "作为关系字段、方向和影响传播规则的唯一机器权威。",
    "use_when": [
      "验证 rel_* 字段或计算变化影响"
    ],
    "do_not_use_when": [
      "登记具体知识实体之间的关系实例"
    ],
    "canonical_location": "schemas/relation-catalog.json",
    "identity_contract": {
      "id_field": "field",
      "filename_stem_equals_id": false,
      "semantic_name_field": "name_zh",
      "semantic_name_normalization": "remove_non_alphanumeric_or_hyphen",
      "semantic_identity": "type_and_file_or_scope",
      "date_capture_pattern": "(?!)",
      "maximum_length": 96,
      "rename_policy": "关系字段重命名必须提供迁移映射并更新全部引用。",
      "collision_policy": "field 必须唯一，重复时阻塞。"
    },
    "body_contract": {
      "format": "json_registry",
      "authoritative_for": [
        "关系名称",
        "方向",
        "允许的源目标",
        "影响传播"
      ],
      "required_sections": [],
      "forbidden_content": [
        "人工维护反向关系列表"
      ]
    },
    "lifecycle": {
      "field": "status",
      "initial_states": [
        "active"
      ],
      "terminal_states": [
        "retired"
      ],
      "transitions": [
        {
          "from": "active",
          "to": "retired",
          "when": "替代关系已登记且所有当前引用完成迁移"
        }
      ],
      "invalid_inferences": [
        "关系可用不表示目标知识存在",
        "Markdown 链接不自动构成关系"
      ]
    },
    "rules": [
      {
        "id": "RULE-SCHEMA-关系目录-关系字段必须唯一",
        "enforcement": "deterministic",
        "description": "每个关系 field 必须唯一。",
        "diagnostic_code": "KB_REL_DUPLICATE",
        "remediation": "删除重复项或分配不同语义字段。"
      },
      {
        "id": "RULE-SCHEMA-关系目录-关系方向必须使用受控事实方向",
