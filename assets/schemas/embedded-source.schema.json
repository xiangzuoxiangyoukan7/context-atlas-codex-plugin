{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-atlas.dev/schemas/embedded-source.schema.json",
  "title": "内嵌来源对象",
  "description": "嵌入知识元数据中的来源、观察时间和来源确认状态。",
  "type": "object",
  "additionalProperties": false,
  "x-context-atlas": {
    "profile": "self_describing/v1",
    "schema_version": "1.0.0",
    "knowledge_type": "embedded_source",
    "purpose": "区分用户陈述、仓库观察、命令输出、文档和 AI 推测，并保留来源自身确认审计。",
    "use_when": [
      "任何正式知识项需要登记事实依据",
      "需要区分 observed 与 confirmed",
      "需要记录来源被看到和被确认的不同时间"
    ],
    "do_not_use_when": [
      "记录 Proposal 的整体批准",
      "保存秘密或未脱敏个人数据",
      "用 confirmed 掩盖 AI 推测或仓库观察"
    ],
    "canonical_location": "作为知识 Schema 的 sources 数组成员，不是独立知识文件",
    "identity_contract": {
      "id_field": "id",
      "filename_stem_equals_id": false,
      "semantic_name_field": "reference",
      "semantic_name_normalization": "remove_non_alphanumeric_or_hyphen",
      "semantic_identity": "type_and_file_or_scope",
      "date_capture_pattern": "(?!)",
      "maximum_length": 96,
      "rename_policy": "语义未发生身份级变化时保持稳定 ID；身份级变化建立后继项并迁移引用。",
      "collision_policy": "目标 ID 或路径冲突时阻塞，不追加隐式序号。"
    },
    "body_contract": {
      "format": "embedded_object",
      "authoritative_for": [
        "单条来源的类型、引用、观察和确认状态"
      ],
      "required_sections": [],
      "forbidden_content": [
        "Proposal 修订确认信息",
        "秘密和未脱敏个人数据"
      ]
    },
    "lifecycle": {
      "field": "confirmation_status",
      "initial_states": [
        "observed"
      ],
      "terminal_states": [
        "confirmed"
      ],
      "transitions": [
        {
          "from": "observed",
          "to": "confirmed",
          "when": "项目责任人真实确认该来源本身，并记录时间"
        }
      ],
      "invalid_inferences": [
        "Proposal 被确认不自动改变来源状态",
        "repository_file 不自动等于 confirmed",
        "ai_inference 不能因检查通过成为事实"
      ]
    },
    "rules": [
      {
        "id": "RULE-SCHEMA-内嵌来源-确认状态必须包含确认时间",
        "enforcement": "json_schema",
        "description": "confirmation_status=confirmed 时必须具有 confirmed_at。",
        "remediation": "补充真实确认时间或保持 observed。"
      },
      {
        "id": "RULE-SCHEMA-内嵌来源-来源类型必须受控",
        "enforcement": "json_schema",
        "description": "来源类型必须使用受控枚举。",
        "remediation": "根据证据产生方式选择类型。"
      },
      {
        "id": "RULE-SCHEMA-内嵌来源-AI推断必须保持可识别",
        "enforcement": "human_review",
        "description": "AI 推测必须保持可辨识且不得伪装成已观察事实。",
        "remediation": "使用 ai_inference，并让承载知识保持 proposed。"
      }
    ],
    "compatibility": {
      "front_matter_validator": "legacy_lightweight_keys",
      "standard_schema_status": "descriptive_until_standard_validator_is_integrated",
      "unknown_value_policy": "不得猜测；缺失或竞争事实必须显式保留。"
    },
    "invalid_examples": [
      {
        "case": "确认但没有时间",
        "value": {
          "type": "user_statement",
          "reference": "当前会话",
          "observed_at": "2026-09-15T00:00:00+08:00",
          "confirmation_status": "confirmed"
        },
        "expected_rule": "RULE-SCHEMA-内嵌来源-确认状态必须包含确认时间",
        "reason": "来源确认不可审计。"
      },
      {
        "case": "未知来源类型",
        "value": {
          "type": "memory",
          "reference": "印象"
        },
        "expected_rule": "RULE-SCHEMA-内嵌来源-来源类型必须受控",
        "reason": "无法区分事实层级。"
      }
    ]
  },
  "properties": {
    "type": {
      "title": "来源类型",
      "description": "说明证据通过何种方式产生。",
      "oneOf": [
        {
          "const": "user_statement",
          "title": "用户陈述",
          "description": "项目责任人在可定位会话中提供的信息",
          "examples": [
            "user_statement"
          ],
          "x-context-atlas": {
            "use_when": [
              "事实直接来自用户表达"
            ]
          }
        },
        {
          "const": "repository_file",
          "title": "仓库文件",
          "description": "从项目仓库文件观察到的内容",
          "examples": [
            "repository_file"
          ],
          "x-context-atlas": {
            "use_when": [
              "可给出项目相对路径"
            ]
          }
        },
        {
          "const": "command_output",
          "title": "命令输出",
          "description": "由可复现命令得到的观察结果",
          "examples": [
            "command_output"
          ],
          "x-context-atlas": {
            "use_when": [
              "命令和环境可定位"
            ]
          }
        },
        {
          "const": "existing_document",
          "title": "现有文档",
          "description": "项目内已有文档提供的信息",
          "examples": [
            "existing_document"
          ],
          "x-context-atlas": {
            "use_when": [
              "文档不是当前专用知识类型"
            ]
          }
        },
        {
          "const": "external_document",
          "title": "外部文档",
          "description": "网页、规范或外部文件提供的信息",
          "examples": [
            "external_document"
          ],
          "x-context-atlas": {
            "use_when": [
              "外部引用可定位且允许使用"
            ]
          }
        },
        {
          "const": "ai_inference",
          "title": "AI 推测",
          "description": "基于证据形成但尚未由责任人确认的推断",
          "examples": [
            "ai_inference"
          ],
          "x-context-atlas": {
            "use_when": [
              "必须显式保持 proposed，不能冒充事实"
            ]
          }
        }
      ],
      "examples": [
        "user_statement"
      ]
    },
    "reference": {
      "title": "来源引用",
      "description": "足以重新定位证据的路径、命令、文档地址或会话说明。",
      "type": "string",
      "minLength": 1,
      "examples": [
        "scripts/project_kb/schema_catalog.py"
      ]
    },
    "observed_at": {
      "title": "观察时间",
      "description": "Agent 或人员实际读取该来源的带时区时间。",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2026-09-15T10:00:00+08:00"
      ]
    },
    "confirmation_status": {
      "title": "来源确认状态",
      "description": "只描述来源本身是否被确认，不描述 Proposal 是否批准。",
      "oneOf": [
        {
          "const": "observed",
          "title": "已观察",
          "description": "只证明在指定时间看到了该来源",
          "examples": [
            "observed"
          ],
          "x-context-atlas": {
            "use_when": [
              "来源尚未由责任人确认"
            ]
          }
        },
        {
          "const": "confirmed",
          "title": "已确认",
          "description": "来源本身已经由责任人确认",
          "examples": [
            "confirmed"
          ],
          "x-context-atlas": {
            "use_when": [
              "具有真实 confirmed_at"
            ]
          }
        }
      ],
      "examples": [
        "observed"
      ]
    },
    "confirmed_at": {
      "title": "来源确认时间",
      "description": "责任人真实确认来源本身的带时区时间；仅 confirmed 时填写。",
      "type": "string",
      "format": "date-time",
      "examples": [
        "2026-09-15T10:05:00+08:00"
      ]
    }
  },
  "required": [
    "type",
    "reference",
    "observed_at",
    "confirmation_status"
  ],
  "examples": [
    {
      "type": "repository_file",
      "reference": "README.md",
      "observed_at": "2026-09-15T10:00:00+08:00",
      "confirmation_status": "observed"
    },
    {
      "type": "user_statement",
      "reference": "当前会话确认",
      "observed_at": "2026-09-15T10:00:00+08:00",
      "confirmation_status": "confirmed",
      "confirmed_at": "2026-09-15T10:05:00+08:00"
    }
  ],
  "enums": {
    "type": [
      "user_statement",
      "repository_file",
      "command_output",
      "existing_document",
      "external_document",
      "ai_inference"
    ],
    "confirmation_status": [
      "observed",
      "confirmed"
    ]
  },
  "patterns": {},
  "allOf": [
    {
      "if": {
        "properties": {
          "confirmation_status": {
            "const": "confirmed"
          }
        },
        "required": [
          "confirmation_status"
        ]
      },
      "then": {
        "required": [
          "confirmed_at"
        ]
      }
    }
  ],
  "x-context-atlas-rules": [
    "[[rules/知识治理规则#RULE-知识治理规则-正式知识和质检结果必须引用来源与目标|RULE-知识治理规则-正式知识和质检结果必须引用来源与目标]]"
  ]
}
