  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-atlas.dev/schemas/project-manifest.schema.json",
  "title": "project_manifest",
  "type": "object",
  "additionalProperties": true,
  "description": "约束知识库机器入口、格式版本和知识修订。",
  "x-context-atlas": {
    "profile": "self_describing/v1",
    "schema_version": "1.0.0",
    "knowledge_type": "project_manifest",
    "purpose": "约束知识库机器入口、格式版本和知识修订。",
    "use_when": [
      "初始化、读取或升级 knowledge-base.yaml"
    ],
    "do_not_use_when": [
      "保存业务需求或项目发布事实"
    ],
    "canonical_location": "knowledge-base.yaml",
    "identity_contract": {
      "id_field": "id",
      "filename_stem_equals_id": false,
      "semantic_name_field": "title",
      "semantic_name_normalization": "remove_non_alphanumeric_or_hyphen",
      "semantic_identity": "type_and_file_or_scope",
      "date_capture_pattern": "(?!)",
      "maximum_length": 160,
      "rename_policy": "稳定身份变化必须通过受控事务迁移全部引用。",
      "collision_policy": "目标身份或路径冲突时阻塞。"
    },
    "body_contract": {
      "format": "json_or_front_matter",
      "authoritative_for": [
        "约束知识库机器入口、格式版本和知识修订。"
      ],
      "required_sections": [],
      "forbidden_content": [
