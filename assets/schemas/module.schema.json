{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-atlas.dev/schemas/module.schema.json",
  "title": "模块知识",
  "description": "具有稳定职责和可定位代码路径的实现模块。",
  "type": "object",
  "additionalProperties": true,
  "x-context-atlas": {
    "profile": "self_describing/v1",
    "schema_version": "1.0.0",
    "knowledge_type": "module",
    "purpose": "记录代码或运行时组件的职责、边界、路径、依赖和技术决策。",
    "use_when": [
      "存在具有长期职责的代码或运行时组件",
      "需要把功能映射到实现边界",
      "模块路径或依赖需跨会话复用"
    ],
    "do_not_use_when": [
      "只描述用户可观察行为",
      "只描述单个接口契约",
      "仅记录临时目录"
    ],
    "canonical_location": "02-技术基线/模块/MOD-<YYYYMMDD>-<语义名称>.md",
    "identity_contract": {
      "id_field": "id",
      "filename_stem_equals_id": true,
      "semantic_name_field": "title",
      "semantic_name_normalization": "remove_non_alphanumeric_or_hyphen",
      "semantic_identity": "type_date_and_semantic_name",
      "date_capture_pattern": "^MOD-([0-9]{8})-",
      "maximum_length": 120,
      "rename_policy": "身份建立日期不可变；普通标题或内容修订保持 ID；身份级改名必须通过已确认事务迁移全部引用。",
      "collision_policy": "目标 ID 或路径冲突时阻塞，不追加隐式序号。"
    },
    "body_contract": {
      "format": "markdown",
      "authoritative_for": [
        "职责",
        "边界",
        "依赖",
        "关键决策"
      ],
      "required_sections": [
        "职责",
        "边界"
      ],
      "forbidden_content": [
        "把目录存在推断为已批准"
      ]
    },
    "lifecycle": {
      "field": "status",
      "initial_states": [
        "missing",
        "proposed"
      ],
      "terminal_states": [
        "archived"
      ],
      "transitions": [
        {
          "from": "proposed",
          "to": "approved",
          "when": "内容通过当前 Proposal 确认"
        },
        {
          "from": "approved",
          "to": "stale",
          "when": "实现变化使描述可能过时"
        },
        {
          "from": "approved",
          "to": "superseded",
          "when": "后继项和迁移关系已建立"
        },
        {
          "from": "superseded",
          "to": "archived",
          "when": "归档 Proposal 已确认"
        }
      ],
      "invalid_inferences": [
        "实现存在不推出 approved",
        "测试通过不自动批准知识",
        "stale 不等于 archived"
      ]
    },
    "rules": [
      {
        "id": "RULE-SCHEMA-模块-必须登记实现路径",
        "enforcement": "deterministic",
        "description": "必须登记至少一个项目相对实现路径。",
        "remediation": "在 paths 中登记文件或目录。",
        "diagnostic_code": "KB_SCHEMA_LIST"
      },
      {
        "id": "RULE-SCHEMA-模块-必须包含来源",
        "enforcement": "deterministic",
        "description": "必须具有至少一个来源。",
        "remediation": "登记受支持来源。",
        "diagnostic_code": "KB_SCHEMA_LIST"
      },
      {
        "id": "RULE-SCHEMA-模块-正文必须说明职责边界",
        "enforcement": "human_review",
        "description": "正文必须说明负责和不负责的边界。",
        "remediation": "补充职责、非职责和依赖边界。"
      }
    ],
    "compatibility": {
      "front_matter_validator": "legacy_lightweight_keys",
      "standard_schema_status": "descriptive_until_standard_validator_is_integrated",
      "unknown_value_policy": "不得猜测；影响契约的未知项必须保留并进入人工复核。"
    },
    "invalid_examples": [
      {
        "case": "没有路径",
        "value": {
          "id": "MOD-技术基线-模块-Schema模块",
          "paths": []
        },
        "expected_rule": "RULE-SCHEMA-模块-必须登记实现路径",
        "reason": "无法定位实现。"
      },
      {
        "case": "没有来源",
        "value": {
          "id": "MOD-技术基线-模块-Schema模块",
          "sources": []
        },
        "expected_rule": "RULE-SCHEMA-模块-必须包含来源",
        "reason": "无法判断事实来源。"
      }
    ]
  },
  "properties": {
    "id": {
      "title": "模块知识稳定编号",
      "description": "由类型、不可变身份建立日期和最小可区分语义名称组成，并与文件名主体一致。",
      "type": "string",
      "pattern": "^[0-9A-Za-z\\u4e00-\\u9fff]+(?:-[0-9A-Za-z\\u4e00-\\u9fff]+)*$",
      "examples": [
        "MOD-20260916-示例知识"
      ]
    },
    "type": {
      "title": "知识类型",
      "description": "固定标识模块知识。",
      "const": "module",
      "examples": [
        "module"
      ]
    },
    "title": {
      "title": "模块知识名称",
      "description": "清楚表达职责或契约目的的阅读名称。",
      "type": "string",
      "minLength": 1,
      "examples": [
        "具有稳定职责和可定位代码"
      ]
    },
    "status": {
      "title": "知识状态",
      "description": "内容的确认和当前权威状态，不表示运行健康。",
      "oneOf": [
        {
          "const": "missing",
          "title": "缺失",
          "description": "已知对象存在但内容不足",
          "examples": [
            "missing"
          ],
          "x-context-atlas": {
            "use_when": [
              "迁移时只能确认对象身份"
            ]
          }
        },
        {
          "const": "proposed",
          "title": "待确认",
          "description": "已有来源的候选等待确认",
          "examples": [
            "proposed"
          ],
          "x-context-atlas": {
            "use_when": [
              "新建或实质修订知识"
            ]
          }
        },
        {
          "const": "approved",
          "title": "已批准",
          "description": "内容已通过当前 Proposal 精确确认",
          "examples": [
            "approved"
          ],
          "x-context-atlas": {
            "use_when": [
              "责任人确认当前 Proposal 修订"
            ]
          }
        },
        {
          "const": "conflicted",
          "title": "存在冲突",
          "description": "至少两个来源给出不能同时成立的值",
          "examples": [
            "conflicted"
          ],
          "x-context-atlas": {
            "use_when": [
              "竞争来源不能由现有证据消解"
            ]
          }
        },
        {
          "const": "stale",
          "title": "可能过时",
          "description": "现有来源可能不再描述当前项目",
          "examples": [
            "stale"
          ],
          "x-context-atlas": {
            "use_when": [
              "实现或依赖变化后尚未核验"
            ]
          }
        },
        {
          "const": "superseded",
          "title": "已被替代",
          "description": "已有明确后继项承接当前权威",
          "examples": [
            "superseded"
          ],
          "x-context-atlas": {
            "use_when": [
              "后继关系和引用迁移已经建立"
            ]
          }
        },
        {
          "const": "archived",
          "title": "已归档",
          "description": "仅保留历史背景，不再构成当前权威",
          "examples": [
            "archived"
          ],
          "x-context-atlas": {
            "use_when": [
              "归档 Proposal 已确认"
            ]
          }
        }
      ],
      "examples": [
        "missing",
        "archived"
      ]
    },
    "paths": {
      "title": "实现路径",
      "description": "项目根相对路径，至少一个且不可重复。",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "examples": [
        [
          "scripts/project_kb/schema_catalog.py"
        ]
      ]
    },
    "sources": {
      "title": "事实来源",
      "description": "至少一个可定位来源，不得把 AI 推测伪装为仓库事实。",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {},
      "examples": [
        [
          {
            "type": "repository_file",
            "reference": "path/to/source"
          }
        ]
      ]
    },
    "last_updated": {
      "title": "最后更新时间",
      "description": "知识最后正式变化日期，使用 YYYY-MM-DD。",
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "examples": [
        "2026-09-15"
      ]
    },
    "identity_created_at": {
      "title": "身份建立日期",
      "description": "该知识稳定身份首次建立的日期；建立后不可因内容修订而改变。",
      "type": "string",
      "format": "date",
      "examples": [
        "2026-09-16"
      ],
      "x-context-atlas": {
        "value_source": "由正式新增或格式升级事务的实际身份建立日期确定，并与 ID 中 YYYYMMDD 一致。",
        "do_not_use_when": [
          "不得使用最后修改日期替代",
          "不得根据业务发生日期猜测"
        ]
      }
    }
  },
  "required": [
    "id",
    "type",
    "title",
    "status",
    "paths",
    "sources",
    "last_updated"
  ],
  "examples": [
    {
      "id": "MOD-技术基线-模块-Schema目录",
      "type": "module",
      "title": "Schema 目录",
      "status": "proposed",
      "paths": [
        "scripts/project_kb/schema_catalog.py"
      ],
      "sources": [
        {
          "type": "repository_file",
          "reference": "scripts/project_kb/schema_catalog.py"
        }
      ],
      "last_updated": "2026-09-15"
    },
    {
      "id": "MOD-技术基线-模块-迁移模块",
      "type": "module",
      "title": "迁移模块",
      "status": "approved",
      "paths": [
        "scripts/project_kb/migration.py"
      ],
      "sources": [
        {
          "type": "repository_file",
          "reference": "scripts/project_kb/migration.py"
        }
      ],
      "last_updated": "2026-09-15"
    }
  ],
  "enums": {
    "type": [
      "module"
    ],
    "status": [
      "missing",
      "proposed",
      "approved",
      "conflicted",
      "stale",
      "superseded",
      "archived"
    ]
  },
  "patterns": {
    "id": "[0-9A-Za-z\\u4e00-\\u9fff]+(?:-[0-9A-Za-z\\u4e00-\\u9fff]+)*",
    "last_updated": "\\d{4}-\\d{2}-\\d{2}"
  },
  "non_empty_lists": [
    "paths",
    "sources"
  ],
  "unique_lists": [
    "paths",
    "sources",
    "blocking_questions"
  ]
}
