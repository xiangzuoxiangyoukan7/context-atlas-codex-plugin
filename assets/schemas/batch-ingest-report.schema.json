{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-atlas.dev/schemas/batch-ingest-report.schema.json",
  "title": "Context Atlas Batch Ingest Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "status",
    "source_count",
    "reports",
    "route_plan",
    "writes_performed",
    "confirmation_state"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "analyzed"
          }
        }
      },
      "then": {
        "properties": {
          "source_count": {
            "maximum": 20
          },
          "reports": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "operation": {
      "const": "batch_ingest",
      "title": "operation",
      "description": "operation 的结构化值；按本 Schema 约束和产生该记录的实际证据填写。",
      "examples": [
        "batch_ingest"
      ]
    },
    "status": {
      "enum": [
        "analyzed",
        "blocked"
      ],
      "title": "status",
      "description": "status 的结构化值；按本 Schema 约束和产生该记录的实际证据填写。",
      "examples": [
        "example"
      ]
    },
    "source_count": {
      "type": "integer",
      "minimum": 1,
      "title": "source_count",
      "description": "source_count 的结构化值；按本 Schema 约束和产生该记录的实际证据填写。",
      "examples": [
        "example"
      ]
    },
    "reports": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "$ref": "ingest-report.schema.json"
      },
      "title": "reports",
      "description": "reports 的结构化值；按本 Schema 约束和产生该记录的实际证据填写。",
      "examples": [
        "example"
      ]
    },
    "route_plan": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "context-atlas-add",
          "context-atlas-revise",
          "context-atlas-retire",
          "context-atlas-init",
          "context-atlas-upgrade"
        ]
      },
      "title": "route_plan",
      "description": "route_plan 的结构化值；按本 Schema 约束和产生该记录的实际证据填写。",
      "examples": [
        "example"
      ]
    },
    "writes_performed": {
      "const": false,
      "title": "writes_performed",
      "description": "writes_performed 的结构化值；按本 Schema 约束和产生该记录的实际证据填写。",
      "examples": [
        false
      ]
    },
    "confirmation_state": {
      "const": "not_applicable",
      "title": "confirmation_state",
      "description": "confirmation_state 的结构化值；按本 Schema 约束和产生该记录的实际证据填写。",
      "examples": [
        "not_applicable"
      ]
    }
  },
  "description": "聚合有限批次来源的只读摄取报告。",
  "x-context-atlas": {
    "profile": "self_describing/v1",
    "schema_version": "1.0.0",
    "knowledge_type": "batch_ingest_report",
    "purpose": "聚合有限批次来源的只读摄取报告。",
    "use_when": [
      "对应运行时操作需要产生机器可读候选或报告"
    ],
    "do_not_use_when": [
      "作为正式知识事实或用户确认的替代品"
    ],
    "canonical_location": "批量摄取操作结果 JSON",
    "identity_contract": {
      "id_field": "status",
      "filename_stem_equals_id": false,
      "semantic_name_field": "status",
      "semantic_name_normalization": "remove_non_alphanumeric_or_hyphen",
      "semantic_identity": "type_and_file_or_scope",
      "date_capture_pattern": "(?!)",
      "maximum_length": 160,
      "rename_policy": "稳定身份变化必须通过受控事务迁移全部引用。",
      "collision_policy": "目标身份或路径冲突时阻塞。"
    },
    "body_contract": {
      "format": "json_or_front_matter",
      "authoritative_for": [
        "聚合有限批次来源的只读摄取报告。"
      ],
      "required_sections": [],
      "forbidden_content": [
        "秘密、私钥、Token 和未脱敏个人数据"
      ]
    },
    "lifecycle": {
      "field": "status",
      "initial_states": [
        "analyzed"
      ],
      "terminal_states": [
        "blocked"
      ],
      "transitions": [],
      "invalid_inferences": [
        "结构合法不表示业务正确或已经批准"
      ]
    },
    "rules": [
      {
        "id": "RULE-SCHEMA-批量摄取报告-结构必须完整",
        "enforcement": "json_schema",
        "description": "所有必填字段、枚举和模式必须满足当前 Schema。",
        "remediation": "按字段说明修正输入。"
      }
    ],
    "compatibility": {
      "standard": "JSON Schema Draft 2020-12",
      "deprecated": false,
      "unknown_value_policy": "不得猜测"
    },
    "invalid_examples": [
      {
        "case": "缺少必填字段",
        "value": {
          "invalid": true
        },
        "expected_rule": "RULE-SCHEMA-批量摄取报告-结构必须完整",
        "reason": "无法形成完整且可执行的契约。"
      }
    ]
  },
  "examples": [
    {
      "operation": "batch_ingest",
      "status": "analyzed",
      "source_count": 1,
      "reports": [
        {
          "operation": "ingest",
          "status": "analyzed",
          "source_identity": {
            "type": "repository_file",
            "reference": "README.md"
          },
          "observed_at": "2026-09-15T00:00:00+08:00",
          "source_digest_or_version": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "scope": [
            "README.md"
          ],
          "candidates": [],
          "route_plan": [],
          "blocked_reasons": [],
          "writes_performed": false,
          "confirmation_state": "not_applicable",
          "next_action": "none"
        }
      ],
      "route_plan": [],
      "writes_performed": false,
      "confirmation_state": "not_applicable"
    },
    {
      "operation": "batch_ingest",
      "status": "blocked",
      "source_count": 21,
      "reports": [],
      "route_plan": [],
      "writes_performed": false,
      "confirmation_state": "not_applicable"
    }
  ]
}
