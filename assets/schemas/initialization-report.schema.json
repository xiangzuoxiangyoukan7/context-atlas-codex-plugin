{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-atlas.dev/schemas/initialization-report.schema.json",
  "title": "Context Atlas Initialization Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "project_root",
    "knowledge_base",
    "proposal_revision",
    "confirmation",
    "execution",
    "written_files",
    "technology_stacks",
    "validation",
    "unknowns",
    "conflicts",
    "next_action"
  ],
  "properties": {
    "operation": {
      "enum": [
        "initialized",
        "failed"
      ],
      "title": "operation",
      "description": "operation 的结构化值；按本 Schema 约束和产生该记录的实际证据填写。",
      "examples": [
        "example"
      ]
    },
    "project_root": {
      "type": "string",
      "title": "project_root",
      "description": "project_root 的结构化值；按本 Schema 约束和产生该记录的实际证据填写。",
      "examples": [
        "example"
      ]
    },
    "knowledge_base": {
      "type": "string",
      "title": "knowledge_base",
      "description": "knowledge_base 的结构化值；按本 Schema 约束和产生该记录的实际证据填写。",
      "examples": [
        "example"
      ]
    },
    "proposal_revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "proposal_revision",
      "description": "proposal_revision 的结构化值；按本 Schema 约束和产生该记录的实际证据填写。",
      "examples": [
        "example"
      ]
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "confirmed_revision"
      ],
      "properties": {
        "state": {
          "const": "confirmed"
        },
        "confirmed_revision": {
          "type": "string"
        }
      },
      "title": "confirmation",
      "description": "confirmation 的结构化值；按本 Schema 约束和产生该记录的实际证据填写。",
      "examples": [
        "example"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "runtime_detection"
      ],
      "properties": {
        "mode": {
          "enum": [
            "python_executor",
            "agent_host"
          ]
        },
        "runtime_detection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "performed_by",
            "platform",
            "attempts",
            "selected_command",
            "capability_checks"
          ],
          "properties": {
            "performed_by": {
              "enum": [
                "agent_host",
                "python_executor"
              ]
            },
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "attempts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "command",
                  "result",
                  "exit_code",
                  "python_major"
                ],
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result": {
                    "enum": [
                      "available",
                      "command_not_found",
                      "windows_store_alias",
                      "wrong_version",
                      "failed"
                    ]
                  },
                  "exit_code": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "python_major": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            },
            "selected_command": {
              "type": [
                "string",
                "null"
              ]
            },
            "capability_checks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "result"
                ],
                "properties": {
                  "name": {
                    "enum": [
                      "read",
                      "create",
                      "enumerate",
                      "compare",
                      "rename"
                    ]
                  },
                  "result": {
                    "enum": [
                      "passed",
                      "failed",
                      "not_required"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "title": "execution",
      "description": "execution 的结构化值；按本 Schema 约束和产生该记录的实际证据填写。",
      "examples": [
        "example"
      ]
    },
    "written_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "written_files",
      "description": "written_files 的结构化值；按本 Schema 约束和产生该记录的实际证据填写。",
      "examples": [
        "example"
      ]
    },
    "technology_stacks": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "technology_stacks",
      "description": "technology_stacks 的结构化值；按本 Schema 约束和产生该记录的实际证据填写。",
      "examples": [
        "example"
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "authority",
        "deterministic_validation",
        "command",
        "exit_code",
        "issue_count",
        "checks"
      ],
      "properties": {
        "result": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "authority": {
          "enum": [
            "deterministic_executor",
            "agent_host"
          ]
        },
        "deterministic_validation": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "command": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "result"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "passed",
                  "failed"
                ]
              }
            }
          }
        }
      },
      "title": "validation",
      "description": "validation 的结构化值；按本 Schema 约束和产生该记录的实际证据填写。",
      "examples": [
        "example"
      ]
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "unknowns",
      "description": "unknowns 的结构化值；按本 Schema 约束和产生该记录的实际证据填写。",
      "examples": [
        "example"
      ]
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "conflicts",
      "description": "conflicts 的结构化值；按本 Schema 约束和产生该记录的实际证据填写。",
      "examples": [
        "example"
      ]
    },
    "next_action": {
      "type": "string",
      "title": "next_action",
      "description": "next_action 的结构化值；按本 Schema 约束和产生该记录的实际证据填写。",
      "examples": [
        "example"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "mode": {
                "const": "agent_host"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "authority": {
                "const": "agent_host"
              },
              "deterministic_validation": {
                "const": "not_run"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "mode": {
                "const": "python_executor"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "authority": {
                "const": "deterministic_executor"
              },
              "deterministic_validation": {
                "enum": [
                  "passed",
                  "failed"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "description": "报告初始化写入、执行方式、验证和剩余问题。",
  "x-context-atlas": {
    "profile": "self_describing/v1",
    "schema_version": "1.0.0",
    "knowledge_type": "initialization_report",
    "purpose": "报告初始化写入、执行方式、验证和剩余问题。",
    "use_when": [
      "对应运行时操作需要产生机器可读候选或报告"
    ],
    "do_not_use_when": [
      "作为正式知识事实或用户确认的替代品"
    ],
    "canonical_location": "初始化操作结果 JSON",
    "identity_contract": {
      "id_field": "operation",
      "filename_stem_equals_id": false,
      "semantic_name_field": "operation",
      "semantic_name_normalization": "remove_non_alphanumeric_or_hyphen",
      "semantic_identity": "type_and_file_or_scope",
      "date_capture_pattern": "(?!)",
      "maximum_length": 160,
      "rename_policy": "稳定身份变化必须通过受控事务迁移全部引用。",
      "collision_policy": "目标身份或路径冲突时阻塞。"
    },
    "body_contract": {
      "format": "json_or_front_matter",
      "authoritative_for": [
        "报告初始化写入、执行方式、验证和剩余问题。"
      ],
      "required_sections": [],
      "forbidden_content": [
        "秘密、私钥、Token 和未脱敏个人数据"
      ]
    },
    "lifecycle": {
      "field": "operation",
      "initial_states": [
        "initialized"
      ],
      "terminal_states": [
        "failed"
      ],
      "transitions": [],
      "invalid_inferences": [
        "结构合法不表示业务正确或已经批准"
      ]
    },
    "rules": [
      {
        "id": "RULE-SCHEMA-初始化报告-结构必须完整",
        "enforcement": "json_schema",
        "description": "所有必填字段、枚举和模式必须满足当前 Schema。",
        "remediation": "按字段说明修正输入。"
      }
    ],
    "compatibility": {
      "standard": "JSON Schema Draft 2020-12",
      "deprecated": false,
      "unknown_value_policy": "不得猜测"
    },
    "invalid_examples": [
      {
        "case": "缺少必填字段",
        "value": {
          "invalid": true
        },
        "expected_rule": "RULE-SCHEMA-初始化报告-结构必须完整",
        "reason": "无法形成完整且可执行的契约。"
      }
    ]
  },
  "examples": [
    {
      "operation": "initialized",
      "project_root": "D:/workspace/example",
      "knowledge_base": "D:/workspace/example/doc-example",
      "proposal_revision": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "confirmation": {
        "state": "confirmed",
        "confirmed_revision": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "execution": {
        "mode": "python_executor",
        "runtime_detection": {
          "performed_by": "python_executor",
          "platform": "windows",
          "attempts": [
            {
              "command": "python",
              "result": "available",
              "exit_code": 0,
              "python_major": 3
            }
          ],
          "selected_command": "python",
          "capability_checks": [
            {
              "name": "read",
              "result": "passed"
            },
            {
              "name": "create",
              "result": "passed"
            }
          ]
        }
      },
      "written_files": [
        "doc-example/README.md"
      ],
      "technology_stacks": [],
      "validation": {
        "result": "passed",
        "authority": "deterministic_executor",
        "deterministic_validation": "passed",
        "command": "python check_knowledge_base.py doc-example",
        "exit_code": 0,
        "issue_count": 0,
        "checks": [
          {
            "name": "structure",
            "result": "passed"
          }
        ]
      },
      "unknowns": [],
      "conflicts": [],
      "next_action": "none"
    },
    {
      "operation": "failed",
      "project_root": "D:/workspace/example",
      "knowledge_base": "D:/workspace/example/doc-example",
      "proposal_revision": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "confirmation": {
        "state": "confirmed",
        "confirmed_revision": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "execution": {
        "mode": "python_executor",
        "runtime_detection": {
          "performed_by": "python_executor",
          "platform": "windows",
          "attempts": [
            {
              "command": "python",
              "result": "available",
              "exit_code": 0,
              "python_major": 3
            }
          ],
          "selected_command": "python",
          "capability_checks": [
            {
              "name": "read",
              "result": "passed"
            },
            {
              "name": "create",
              "result": "passed"
            }
          ]
        }
      },
      "written_files": [
        "doc-example/README.md"
      ],
      "technology_stacks": [],
      "validation": {
        "result": "failed",
        "authority": "deterministic_executor",
        "deterministic_validation": "failed",
        "command": "python check_knowledge_base.py doc-example",
        "exit_code": 1,
        "issue_count": 1,
        "checks": [
          {
            "name": "structure",
            "result": "failed"
          }
        ]
      },
      "unknowns": [],
      "conflicts": [],
      "next_action": "none"
    }
  ]
}
