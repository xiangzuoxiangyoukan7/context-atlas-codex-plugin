  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-atlas.dev/schemas/task.schema.json",
  "title": "task",
  "type": "object",
  "additionalProperties": true,
  "description": "记录实现某一功能的可执行工作及其验收关联。",
  "x-context-atlas": {
    "profile": "self_describing/v1",
    "schema_version": "1.0.0",
    "knowledge_type": "task",
    "purpose": "记录实现某一功能的可执行工作及其验收关联。",
    "use_when": [
      "需要把实施工作关联到具体功能和验收场景"
    ],
    "do_not_use_when": [
      "用任务状态替代功能验收或知识确认"
    ],
    "canonical_location": "90-历史归档/实施任务包/TASK-<原领域层级>-<名称>.md",
    "identity_contract": {
      "id_field": "id",
      "filename_stem_equals_id": false,
      "semantic_name_field": "title",
      "semantic_name_normalization": "remove_non_alphanumeric_or_hyphen",
      "semantic_identity": "type_and_file_or_scope",
      "date_capture_pattern": "(?!)",
      "maximum_length": 160,
      "rename_policy": "稳定身份变化必须通过受控事务迁移全部引用。",
      "collision_policy": "目标身份或路径冲突时阻塞。"
    },
    "body_contract": {
      "format": "json_or_front_matter",
      "authoritative_for": [
        "记录实现某一功能的可执行工作及其验收关联。"
      ],
      "required_sections": [],
      "forbidden_content": [
        "秘密、私钥、Token 和未脱敏个人数据"
      ]
    },
    "lifecycle": {
      "field": "status",
      "initial_states": [
        "draft"
      ],
      "terminal_states": [
        "completed"
      ],
      "transitions": [],
      "invalid_inferences": [
        "结构合法不表示业务正确或已经批准"
      ]
    },
    "rules": [
      {
        "id": "RULE-SCHEMA-任务-结构必须完整",
        "enforcement": "json_schema",
        "description": "所有必填字段、枚举和模式必须满足当前 Schema。",
        "remediation": "按字段说明修正输入。"
      }
    ],
    "compatibility": {
      "standard": "JSON Schema Draft 2020-12",
      "deprecated": false,
      "unknown_value_policy": "不得猜测"
    },
    "invalid_examples": [
